<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="swarm_arena">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-7 -9 10 0 0.75 0.95</pose>
      </camera>
    </gui>
    <model name="north_wall">
      <static>true</static>
      <pose>0 5.1 0.2 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.4 0.2 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10.4 0.2 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -5.1 0.2 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.4 0.2 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10.4 0.2 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>5.1 0 0.2 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 10 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 10 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-5.1 0 0.2 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 10 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 10 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Pose/velocity reset without rewinding ROS simulated time. -->
    <plugin name="environment_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/swarm/simulation</namespace></ros>
      <update_rate>10</update_rate>
    </plugin>
  </world>
</sdf>