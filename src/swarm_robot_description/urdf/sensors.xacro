<?xml version="1.0"?>
<!-- Mount and simulate a central IMU and a lightweight three-ray front distance scanner. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_mount" params="name xyz size color">
    <!-- Tiny boxes identify sensor frames; no extra collision at the dock face. -->
    <link name="${prefix}${name}_link">
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="${color}"/>
      </visual>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
      </inertial>
    </link>
    <joint name="${prefix}${name}_joint" type="fixed">
      <parent link="${prefix}base_link"/><child link="${prefix}${name}_link"/>
      <origin xyz="${xyz}"/>
    </joint>
    <gazebo reference="${prefix}${name}_link"><material>Gazebo/Grey</material></gazebo>
  </xacro:macro>

  <xacro:macro name="swarm_sensors" params="">
    <!-- At the chassis centre in XY, just above its top face. -->
    <xacro:sensor_mount name="imu" xyz="0 0 ${height / 2 + 0.003}"
                        size="0.012 0.012 0.004" color="silver"/>
    <gazebo reference="${prefix}imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <!-- Ideal IMU: no bias, drift or noise model in this milestone. -->
        <plugin name="imu" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>${robot_namespace}</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <frame_name>${prefix}imu_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Above the front lip; leaves the lower front free for a future dock.
         Local +X is the measurement axis. A three-ray fan is not a full lidar. -->
    <xacro:sensor_mount name="front_range" xyz="${length / 2 + 0.002} 0 ${height / 2 + 0.005}"
                        size="0.006 0.012 0.008" color="silver"/>
    <gazebo reference="${prefix}front_range_link">
      <sensor name="front_range_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>3</samples><resolution>1</resolution>
              <min_angle>-0.025</min_angle><max_angle>0.025</max_angle>
            </horizontal>
          </scan>
          <range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range>
        </ray>
        <plugin name="front_range" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>${robot_namespace}</namespace>
            <remapping>~/out:=range/front</remapping>
          </ros>
          <!-- LaserScan retains +inf for no return. Classic's Range conversion
               uses FLT_MAX, rejected by this Humble Python Range binding. -->
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${prefix}front_range_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
