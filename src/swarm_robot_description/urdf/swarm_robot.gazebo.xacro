<?xml version="1.0"?>
<!-- Configure namespaced Gazebo drive and wheel joint-state plugins and contact properties. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- DDS represents inter-robot Wi-Fi communication; no radio model.
       On hardware, ESP32 firmware + TB6612 replace this drive plugin. -->
  <xacro:macro name="swarm_drive" params="">
    <gazebo>
      <!-- Direct Gazebo Classic drive: no controller manager is needed. -->
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>${robot_namespace}</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <left_joint>${prefix}left_wheel_joint</left_joint>
        <right_joint>${prefix}right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
        <max_wheel_torque>0.05</max_wheel_torque>
        <max_wheel_acceleration>0.5</max_wheel_acceleration>
        <!-- World pose preserves the working baseline and includes wheel slip.
             Wheel positions/velocities below are the ideal encoder interface. -->
        <odometry_source>1</odometry_source>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <!-- robot_state_publisher owns all transforms inside the robot. -->
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_frame>${prefix}odom</odometry_frame>
        <robot_base_frame>${prefix}base_footprint</robot_base_frame>
      </plugin>
      <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
        <ros><namespace>${robot_namespace}</namespace></ros>
        <update_rate>50</update_rate>
        <joint_name>${prefix}left_wheel_joint</joint_name>
        <joint_name>${prefix}right_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
