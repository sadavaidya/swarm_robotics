Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane Cell Count: 10
    Reference Frame: world
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Marker Scale: 0.08
    Show Arrows: true
    Show Axes: true
    Show Names: false
  - Class: rviz_default_plugins/RobotModel
    Name: Robot 1
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_1/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/Odometry
    Name: Robot 1 odometry
    Enabled: true
    Topic:
      Value: /robot_1/odom
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
    Keep: 40
    Position Tolerance: 0.1
    Angle Tolerance: 0.2
    Shape:
      Value: Arrow
      Color: 255; 80; 0
      Alpha: 1
      Shaft Length: 0.09
      Shaft Radius: 0.002
      Head Length: 0.03
      Head Radius: 0.006
    Covariance:
      Value: false
  - Class: rviz_default_plugins/RobotModel
    Name: Robot 2
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_2/robot_description
      Durability Policy: Transient Local
