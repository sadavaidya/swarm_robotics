<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Network transport also avoids shared-memory reader locks when fault tests
       suspend an agent. ROS topic reliability/durability remain set in code. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>swarm_udp</transport_id><type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="participant_profile_ros2" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>swarm_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
